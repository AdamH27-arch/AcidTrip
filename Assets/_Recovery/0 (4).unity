MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1828208561}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ae8432ccd0104d447a769be41de2d0f4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialController
  welcomePanel: {fileID: 1472341310}
  _steps:
  - id: controls
    title: CONTROLS
    description: 'Use WASD to move

      LEFT SHIFT to dash

      LEFT CLICK to
      attack'
    target: {fileID: 0}
    anchor: 4
    pauseGame: 1
  - id: xp_bar
    title: XP BAR
    description: This is your xp bar. Gather XP around the map to level up your stats!
    target: {fileID: 740782456}
    anchor: 0
    pauseGame: 1
  - id: round
    title: ROUND COUNTER
    description: This shows what round you are on. Good luck trying to get to 20....
    target: {fileID: 424189585}
    anchor: 1
    pauseGame: 1
  - id: wave
    title: WAVE COUNTER
    description: Some rounds will have multiple waves of enemies.
    target: {fileID: 74797790}
    anchor: 1
    pauseGame: 1
  - id: timer
    title: WAVE TIMER
    description: This shows you how long until the current wave ends. You will have
      a short smount of time between waves to gather XP.
    target: {fileID: 735778438}
    anchor: 1
    pauseGame: 1
  - id: enemies
    title: ENEMIES ALIVE
    description: Some waves or rounds require you to kill all of the enemies rather
      than survive for a specific amount of time.
    target: {fileID: 1574678529}
    anchor: 1
    pauseGame: 1
  - id: levelup
    title: LEVEL UP
    description: Press TAB to open your stat menu. Each time you level up, you get
      one point to use to upgrade your character!
    target: {fileID: 1304005460}
    anchor: 3
    pauseGame: 1
  - id: item_drops
    title: ITEMS
    description: Enemies occasionally drop items when they die. Walk over them to
      pick them up instantly. There is no inventory so items take effect immediately.
    target: {fileID: 0}
    anchor: 4
    pauseGame: 1
  _initialTourCount: 6
  _popupOffset: 24
